{"nodes": [{"id": "docker_compose_doc", "label": "docker-compose.yml", "file_type": "code", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_csp_header", "label": "Traefik CSP unsafe-inline Header", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The CSP's script-src must allow 'unsafe-inline' because TanStack Start's streaming SSR emits dynamic per-request inline scripts (hydration bootstrap + $tsr stream barrier) that cannot be pre-hashed; a hash/nonce would make browsers ignore 'unsafe-inline' and break hydration."}, {"id": "docker_compose_loopback_binding", "label": "Loopback Port Binding (Traefik Bypass Prevention)", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The production app's port is bound to 127.0.0.1 only, not 0.0.0.0, so Traefik reaches it over the internal 'proxy' network \u2014 this keeps the app off a plain-HTTP path that would bypass Traefik's TLS termination and security headers."}], "edges": [{"source": "docker_compose_doc", "target": "docker_compose_csp_header", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": null, "weight": 1.0}, {"source": "docker_compose_doc", "target": "docker_compose_loopback_binding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": null, "weight": 1.0}, {"source": "docker_compose_doc", "target": "docs_claude_deployment_vapid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": null, "weight": 1.0},