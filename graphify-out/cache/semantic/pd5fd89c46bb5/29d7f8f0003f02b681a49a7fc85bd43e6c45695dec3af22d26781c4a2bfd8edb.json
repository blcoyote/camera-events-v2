{"nodes": [{"id": "claude_doc", "label": "CLAUDE.md Project Instructions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_event_batcher_burst", "label": "EventBatcher Burst Detection", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current behavior: EventBatcher flushes a camera's first event immediately (leading edge), batches follow-ups into EVENT_BATCH_WINDOW_MS windows, and each flush reports whether it opens a new activity burst (no events for EVENT_BURST_GAP_MS) or continues one \u2014 bursts alert once and continuations silently patch the existing notification, paced for Apple endpoints via APPLE_UPDATE_INTERVAL_MS."}, {"id": "claude_feature_sliced_architecture", "label": "Feature-Sliced Architecture", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each feature owns its own folder under src/features/ with all of its components, hooks, utilities, types, and server logic; features must never import from each other, and shared logic goes in src/features/shared/ \u2014 duplication is preferred over cross-feature coupling."}, {"id": "claude_model_delegation", "label": "Opus-Plans/Sonnet-Implements Delegation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opus is reserved for planning (understanding the codebase, designing approach, decomposing work, reviewing diffs, architectural/security trade-offs) so the expensive reasoning model is not spent on mechanical work; Sonnet implements pre-decomposed, Sonnet-sized chunks with concrete file targets and no open design questions left unresolved."}, {"id": "claude_memory_vault", "label": "Long-Term Memory Vault (Obsidian docs/memory)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bd (beads) is for actionable, short-lived issue tracking; the Obsidian vault at docs/memory/ is for durable, explanatory knowledge (architectural rationale, platform gotchas, decision records) so it isn't lost at session end \u2014 the two stores are deliberately kept separate."}, {"id": "claude_session_completion", "label": "Mandatory Session Completion Workflow", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work is not considered complete until git push succeeds; the mandated workflow (file issues, run quality gates, update issue status, push, clean up, verify) exists so work is never left stranded only on the local machine."}, {"id": "claude_no_ai_attribution", "label": "No AI Attribution Rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Co-Authored-By trailers, 'Generated with Claude' footers, or other AI attribution may appear in commit messages, PR titles/bodies, code comments, or any pushed artifact, for any AI tool."}], "edges": [{"source": "claude_doc", "target": "beads_readme_beads", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "beads_readme_bd_cli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "github_copilot_instructions_bun_enforcement", "relation": "reference