{"nodes": [{"id": "claude_skills_test_driven_development_skill_doc", "label": "Test-Driven Development Skill", "file_type": "document", "source_file": ".claude/skills/test-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_test_driven_development_skill_red_green_refactor", "label": "Red-Green-Refactor Cycle", "file_type": "rationale", "source_file": ".claude/skills/test-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforces strict RED-GREEN-REFACTOR with hard gates because LLMs are especially prone to skipping tests or writing them after implementation, which produces code that looks tested but was never actually validated."}, {"id": "claude_skills_test_driven_development_skill_horizontal_slicing", "label": "Horizontal Slicing Anti-Pattern", "file_type": "rationale", "source_file": ".claude/skills/test-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing all tests first and then all implementation ('horizontal slicing') produces tests that check imagined behavior/shape rather than actual behavior, making them insensitive to real regressions."}, {"id": "claude_skills_test_driven_development_skill_tracer_bullet", "label": "Vertical Slicing / Tracer Bullet", "file_type": "rationale", "source_file": ".claude/skills/test-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One test then one implementation, repeated: the first vertical slice is a tracer bullet proving the path works end-to-end before investing in breadth, so a bad design assumption costs one wasted cycle instead of five."}], "edges": [{"source": "claude_skills_test_driven_development_skill_doc", "target": "claude_skills_test_driven_development_skill_red_green_refactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/test-driven-development/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_test_driven_development_skill_doc", "target": "claude_skills_test_driven_development_skill_horizontal_slicing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/test-driven-development/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_test_driven_development_skill_doc", "target": "claude_skills_test_driven_development_skill_tracer_bullet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/test-driven-development/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}