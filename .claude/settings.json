{
  "enabledPlugins": {
    "agentic-dev-team@bfinster": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": []
  },
  "permissions": {
    "allow": [
      "Skill(agentic-dev-team:help)",
      "Skill(agentic-dev-team:plan)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "WebFetch(domain:docs.frigate.video)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "WebFetch(domain:tanstack.com)"
    ]
  }
}
