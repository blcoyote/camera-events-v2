{
  "name": "camera-events-v2",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "dev": "vite dev --port 3000",
    "build": "vite build && cp -r src/features/shared/server/frigate/assets .output/server/_ssr/",
    "preview": "bun run build && bun run .output/server",
    "test": "vitest run",
    "verify:bun-bundle": "node scripts/verify-bun-bundle.mjs",
    "audit:advisories": "bun scripts/audit-advisories.ts",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check --write .",
    "knip": "knip",
    "prepare": "husky",
    "start": "bun run .output/server"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/router-plugin": "1.168.48",
    "arctic": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-webcrypto": "^2",
    "lucide-react": "^1.66.0",
    "mqtt": "^5.16.0",
    "nitro": "^3.0.260610-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serwist": "^9.5.13",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@serwist/build": "^9.5.13",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "5.0.5",
    "better-sqlite3": "^13.0.3",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,yml,yaml}": "biome check --write --no-errors-on-unmatched"
  }
}
