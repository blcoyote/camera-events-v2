# Google OAuth credentials — get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session encryption key — must be at least 32 characters.
# In Docker Compose, leave this unset: the entrypoint auto-generates a stable
# secret on first startup and persists it in the data volume. It survives
# container recreations and redeployments as long as the volume is intact.
# Set this explicitly only if you need to migrate an existing secret or share
# it across multiple instances.
# SESSION_SECRET=at-least-32-characters-long-secret-here

# Application URL — set in production to prevent Host header manipulation
# In development, falls back to the request origin automatically
# APP_URL=https://your-app.example.com

# Frigate NVR URL — base URL of your Frigate instance
# Example: http://192.168.1.100:5000 or http://frigate.local:5000
FRIGATE_URL=http://your-frigate-host:5000

# Mock Frigate client — returns randomized data without a real Frigate server
# Useful for frontend development. No FRIGATE_URL needed when enabled.
# FRIGATE_MOCK=true

# MQTT broker — RabbitMQ with MQTT plugin (used for real-time Frigate events)
# In Docker Compose this is set automatically to mqtt://rabbitmq:1883
# MQTT_URL=mqtt://localhost:1883

# RabbitMQ credentials (used by docker-compose for the broker)
# RABBITMQ_USER=frigate
# RABBITMQ_PASS=frigate

# Event batching window (ms) — how long to collect events per camera before
# sending a push notification. Higher values reduce notification spam.
# A camera's FIRST event is always sent immediately; this window only paces the
# follow-up pushes that silently patch that notification.
# EVENT_BATCH_WINDOW_MS=30000

# Burst gap (ms) — how long a camera must stay quiet before its next event
# counts as new activity and alerts you again. Within the gap, further events
# silently patch the existing notification instead of re-alerting.
# Lower it to hear about renewed activity sooner; raise it to be alerted less.
# EVENT_BURST_GAP_MS=600000

# Apple update interval (ms) — minimum spacing between the silent patch pushes
# sent to a single iOS/Safari device, per camera. iOS ignores the "silent" flag
# and alerts on every notification it receives, so patches to Apple devices are
# paced; Android and desktop always receive them immediately.
# Raise it for fewer iOS buzzes at the cost of a staler count, or set 0 to
# disable pacing and let iOS behave like Android.
# APPLE_UPDATE_INTERVAL_MS=300000

# Camera offline threshold (reading count) — consecutive zero-fps frigate/stats
# readings required before a camera is flagged offline. Raise it to be more
# resistant to transient FPS blips at the cost of a slower initial alert;
# lower it (minimum 1) for faster but noisier detection.
# CAMERA_OFFLINE_THRESHOLD=10

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
# Push notifications are disabled when these are not set (server logs a warning).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-email@example.com
